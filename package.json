{
  "name": "@leoc-22/pi-diff",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "description": "A Pi extension that renders local Git diffs with @pierre/diffs and @pierre/trees",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "git",
    "diff"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leoc-22/pi-diff.git"
  },
  "homepage": "https://github.com/leoc-22/pi-diff#readme",
  "bugs": {
    "url": "https://github.com/leoc-22/pi-diff/issues"
  },
  "files": [
    "index.ts",
    "src/**/*.ts",
    "dist/client/**",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@pierre/diffs": "1.3.6",
    "@pierre/trees": "1.0.0-beta.6",
    "open": "^11.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
